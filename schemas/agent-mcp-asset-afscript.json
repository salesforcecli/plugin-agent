{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ApiCatalogMcpServerAssetAfscriptResult",
  "definitions": {
    "ApiCatalogMcpServerAssetAfscriptResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundle": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "subagents": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SubagentUpdate"
              }
            }
          },
          "required": ["name", "file", "subagents"],
          "additionalProperties": false
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/McpAgentScriptActionOutput"
          }
        }
      },
      "required": ["actions"]
    },
    "SubagentUpdate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["name", "added", "skipped"],
      "additionalProperties": false
    },
    "McpAgentScriptActionOutput": {
      "type": "object",
      "properties": {
        "toolId": {
          "type": "string"
        },
        "genAiFunctionId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "actionBlock": {
          "type": "string"
        },
        "reasoningReference": {
          "type": "string"
        }
      },
      "required": ["toolId", "genAiFunctionId", "name", "source", "target", "actionBlock", "reasoningReference"],
      "additionalProperties": false
    }
  }
}
