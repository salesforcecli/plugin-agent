{
  "extends": "@salesforce/dev-config/tsconfig-strict-esm",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "jsx": "react",
    "skipLibCheck": true,
    "paths": {
      "@salesforce/core": ["./node_modules/@salesforce/core"]
    },
    "types": ["mocha"]
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"]
}
